# keep line endings consistent whatever machine the repo is checked out on.
* text=auto

# sql, python, markdown and data stay unix-style so psql and the test read them the same everywhere.
*.sql text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf

# powershell scripts stay windows-style, which windows powershell 5.1 expects.
*.ps1 text eol=crlf

# the supplied bundle is kept byte for byte as shipped.
M03_Resources/** -text
*.sha256 text eol=lf
