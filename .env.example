# local database settings, for the throwaway docker database main.py creates.
# you don't need to copy this: main.py creates .env with a random password the first
# time you run it. edit .env, never this file, and never commit .env.
POSTGRES_CONTAINER=kloudkart
POSTGRES_PORT=5433
POSTGRES_DB=kloudkart
POSTGRES_PASSWORD=put-your-password-here
